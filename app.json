{
  "expo": {
    "name": "Rockview Clearance Hub",
    "slug": "rockview-clearance-hub",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#15803d"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#15803d"
      },
      "package": "com.rockview.clearancehub",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Rockview Clearance Hub to use the camera to scan receipts and past papers.",
          "recordAudioAndroidPermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Rockview Clearance Hub to use the camera to scan receipts and past papers."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "f366ebec-f4c3-4fe9-b91d-4923fc157fea"
      }
    }
  }
}